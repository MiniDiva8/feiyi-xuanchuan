FROM node:24-slim AS web
WORKDIR /build
COPY apps/web/package*.json ./
RUN npm ci
COPY apps/web/ ./
RUN npm run build

FROM python:3.12-slim AS platform
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/services/api:/app/services/marketing-ai
WORKDIR /app
COPY services/api/requirements.txt /app/services/api/requirements.txt
RUN pip install --no-cache-dir -r services/api/requirements.txt && useradd --create-home --uid 10001 platform
COPY services/api/ /app/services/api/
COPY services/marketing-ai/ /app/services/marketing-ai/
COPY --from=web /build/dist/ /app/apps/web/dist/
RUN mkdir -p /app/.data && chown -R platform:platform /app/.data
USER platform
EXPOSE 8010
CMD ["python","-m","uvicorn","app.main:app","--host","0.0.0.0","--port","8010"]
