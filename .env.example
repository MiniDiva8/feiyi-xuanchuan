# Local SQLite needs no database credentials. Copy this file to .env only if configuring AI or Docker.
# Never commit .env or real secrets. AI fields are server-only.
MARKETING_AI_API_KEY=
MARKETING_AI_BASE_URL=https://api.deepseek.com
MARKETING_AI_MODEL=deepseek-flash
MARKETING_AI_TIMEOUT_SECONDS=60
MARKETING_AI_MAX_OUTPUT_TOKENS=2400
MARKETING_AI_THINKING=disabled
# Required for Docker Compose only: use a long random URL-safe password.
POSTGRES_PASSWORD=
